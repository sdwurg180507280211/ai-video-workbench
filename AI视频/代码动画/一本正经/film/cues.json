 "subs": [
  {
   "t": [
    0.6,
    1.59
   ],
   "text": "问问 AI"
  },
  {
   "t": [
    1.59,
    3.34
   ],
   "text": "小团子的生日是哪天？"
  },
  {
   "t": [
    3.94,
    4.79
   ],
   "text": "它说"
  },
  {
   "t": [
    4.79,
    5.84
   ],
   "text": "三月七号"
  },
  {
   "t": [
    6.48,
    7.69
   ],
   "text": "再问一次"
  },
  {
   "t": [
    7.69,
    8.84
   ],
   "text": "六月十五号"
  },
  {
   "t": [
    9.52,
    10.31
   ],
   "text": "再问"
  },
  {
   "t": [
    10.31,
    11.26
   ],
   "text": "一月一号"
  },
  {
   "t": [
    11.9,
    13.97
   ],
   "text": "每次都说得特别肯定"
  },
  {
   "t": [
    13.97,
    15.05
   ],
   "text": "可一个都不对"
  },
  {
   "t": [
    19.85,
    21.1
   ],
   "text": "它平时练的"
  },
  {
   "t": [
    21.1,
    21.6
   ],
   "text": "是接话"
  },
  {
   "t": [
    21.97,
    23.61
   ],
   "text": "读很多很多文字"
  },
  {
   "t": [
    23.61,
    24.66
   ],
   "text": "看前半句"
  },
  {
   "t": [
    24.66,
    27.12
   ],
   "text": "猜下一个字最可能是什么"
  },
  {
   "t": [
    27.12,
    27.98
   ],
   "text": "练得越多"
  },
  {
   "t": [
    27.98,
    28.87
   ],
   "text": "接得越顺"
  },
  {
   "t": [
    32.57,
    34.72
   ],
   "text": "书里写过很多遍的事"
  },
  {
   "t": [
    34.72,
    36.51
   ],
   "text": "比如小猫爱吃鱼"
  },
  {
   "t": [
    36.51,
    38.23
   ],
   "text": "它接得又顺又准"
  },
  {
   "t": [
    38.83,
    40.32
   ],
   "text": "可小团子的生日"
  },
  {
   "t": [
    40.32,
    42.2
   ],
   "text": "书里几乎没写过"
  },
  {
   "t": [
    42.2,
    44.07
   ],
   "text": "它不知道该接哪天"
  },
  {
   "t": [
    44.07,
    47.29
   ],
   "text": "只能挑一个像模像样的日期接上去"
  },
  {
   "t": [
    51.19,
    52.98
   ],
   "text": "那它为什么说得这么肯定？"
  },
  {
   "t": [
    52.98,
    54.48
   ],
   "text": "因为它读过的句子"
  },
  {
   "t": [
    54.48,
    56.38
   ],
   "text": "几乎都是直接给答案的"
  },
  {
   "t": [
    56.38,
    58.07
   ],
   "text": "很少有人写“我不知道”"
  },
  {
   "t": [
    58.47,
    61.19
   ],
   "text": "它学会了把话说得又顺又肯定"
  },
  {
   "t": [
    61.19,
    63.04
   ],
   "text": "却不会主动先查一查"
  },
  {
   "t": [
    66.74,
    68.8
   ],
   "text": "为什么不干脆说不知道？"
  },
  {
   "t": [
    68.8,
    69.36
   ],
   "text": "想想考试"
  },
  {
   "t": [
    69.89,
    71.18
   ],
   "text": "选择题空着"
  },
  {
   "t": [
    71.18,
    72.47
   ],
   "text": "一定是零分"
  },
  {
   "t": [
    72.47,
    73.54
   ],
   "text": "随便蒙一个"
  },
  {
   "t": [
    73.54,
    75.04
   ],
   "text": "还有四分之一的机会"
  },
  {
   "t": [
    78.54,
    80.85
   ],
   "text": "很多考 AI 的测试也这样"
  },
  {
   "t": [
    80.85,
    82.54
   ],
   "text": "说不知道不得分"
  },
  {
   "t": [
    82.54,
    84.04
   ],
   "text": "蒙对了才得分"
  },
  {
   "t": [
    84.04,
    85.69
   ],
   "text": "所以它更容易被训练成"
  },
  {
   "t": [
    86.09,
    87.3
   ],
   "text": "不会也要写满"
  },
  {
   "t": [
    90.8,
    92.11
   ],
   "text": "同样十道题"
  },
  {
   "t": [
    92.11,
    94.07
   ],
   "text": "老老实实说“不知道”的那个"
  },
  {
   "t": [
    94.07,
    95.11
   ],
   "text": "得六分"
  },
  {
   "t": [
    95.11,
    96.54
   ],
   "text": "不会就蒙的那个"
  },
  {
   "t": [
    96.54,
    97.43
   ],
   "text": "得七分"
  },
  {
   "t": [
    97.43,
    98.26
   ],
   "text": "还排第一"
  },
  {
   "t": [
    98.65,
    100.51
   ],
   "text": "可它蒙的四道都是猜的"
  },
  {
   "t": [
    100.89,
    102.06
   ],
   "text": "一道碰巧对"
  },
  {
   "t": [
    102.06,
    103.03
   ],
   "text": "三道错了"
  },
  {
   "t": [
    107.73,
    109.04
   ],
   "text": "所以要紧的事"
  },
  {
   "t": [
    109.04,
    110.74
   ],
   "text": "让它把出处列出来"
  },
  {
   "t": [
    110.74,
    112.02
   ],
   "text": "再点开看看"
  },
  {
   "t": [
    112.02,
    113.8
   ],
   "text": "里面到底有没有这么说"
  },
  {
   "t": [
    114.15,
    116.98
   ],
   "text": "现在有些 AI 会先上网搜一搜"
  },
  {
   "t": [
    116.98,
    117.83
   ],
   "text": "有些会直接说"
  },
  {
   "t": [
    118.36,
    119.42
   ],
   "text": "这个我不确定"
  },
  {
   "t": [
    123.52,
    124.32
   ],
   "text": "接得顺"
  },
  {
   "t": [
    124.32,
    125.71
   ],
   "text": "不等于说得对"
  },
  {
   "t": [
    125.71,
    126.55
   ],
   "text": "见得少"
  },
  {
   "t": [
    126.55,
    127.74
   ],
   "text": "它就靠猜"
  },
  {
   "t": [
    127.74,
    128.4
   ],
   "text": "不会的"
  },
  {
   "t": [
    128.4,
    129.38
   ],
   "text": "也常常写满"
  },
  {
   "t": [
    133.18,
    135.43
   ],
   "text": "下次 AI 答得特别肯定"
  },
  {
   "t": [
    135.43,
